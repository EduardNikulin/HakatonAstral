# Виртуальные окружения Python (любое расположение)
venv/
.venv/
env/
ENV/

# Кэш Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Локальные секреты: реальный .env НЕ коммитим, .env.example — эталон без паролей — коммитим
.env
.env.local

# SQLite-файлы от smoke-тестов и локальных прогонов (не база и не код — мусор)
*.db
*.sqlite3

# Node.js: зависимости и сборка фронта
node_modules/
dist/
npm-debug.log*

# IDE и ОС
.idea/
.vscode/
*.swp
.DS_Store
